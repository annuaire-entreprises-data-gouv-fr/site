    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/remark-heading-id": "1.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.8",
    "js-yaml": "5.5.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.1",
    "msw": "3.0.3",
