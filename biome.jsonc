{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/tanstack"],
  "files": {
    "includes": [
      "!**/*.min.css",
      "!src/e2e-mock/fixtures/**/*.json",
      "!src/clients/_test/**/*.json",
      "!src/data/**/*.json",
      // vendored icons and logos, and standalone static error pages
      "!**/*.svg",
      "!public/*.html"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noNestedTernary": "off",
        "noIncrementDecrement": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "useAwait": "off",
        "noConsole": "off",
        // relies on TS types, which don't guarantee the shape of external API data
        "noUnnecessaryConditions": "off",
        "noEqualsToNull": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noBarrelFile": "off",
        "noJsxPropsBind": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "correctness": {
        "useJsxKeyInIterable": "off",
        "noUnknownMediaFeatureName": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "overrides": [
    {
      // vitest globals (tsconfig "vitest/globals")
      "includes": [
        "**/*.test.{ts,tsx}",
        "src/clients/_test/**",
        "setup-vitest.ts"
      ],
      "javascript": {
        "globals": [
          "describe",
          "it",
          "test",
          "expect",
          "vi",
          "beforeAll",
          "beforeEach",
          "afterAll",
          "afterEach"
        ]
      }
    }
  ]
}
