{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/tanstack"],
  "files": {
    "includes": [
      "!**/*.min.css",
      "!src/e2e-mock/fixtures/**/*.json",
      "!src/clients/_test/**/*.json",
      "!src/data/**/*.json",
      // vendored icons and logos, and standalone static error pages
      "!**/*.svg",
      "!public/*.html"
    ]
  },
  "linter": {
    // Preserve the existing lint policy; adopt new Biome/Ultracite rules separately.
    "rules": {
      "style": {
        "noNestedTernary": "off",
        "noIncrementDecrement": "off",
        "useDomQuerySelector": "off",
        "useNamedCaptureGroup": "off",
        "useReduceTypeParameter": "off",
        "useThisInClassMethods": "off",
        "useUnicodeRegex": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "useAwait": "off",
        "noConsole": "off",
        // relies on TS types, which don't guarantee the shape of external API data
        "noUnnecessaryConditions": "off",
        "noEqualsToNull": "off",
        "noDuplicateSelectors": "off",
        "useBaseline": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noBarrelFile": "off",
        "noJsxPropsBind": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "useArraySome": "off",
        "useMathMinMax": "off",
        "useRegexpTest": "off"
      },
      "correctness": {
        "useJsxKeyInIterable": "off",
        "noUnknownMediaFeatureName": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off",
        "useIframeSandbox": "off"
      }
    }
  },
  "yaml": {
    "formatter": { "enabled": false }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "assist": {
        "actions": { "source": { "useSortedProperties": "off" } }
      }
    },
    {
      // vitest globals (tsconfig "vitest/globals")
      "includes": [
        "**/*.test.{ts,tsx}",
        "src/clients/_test/**",
        "setup-vitest.ts"
      ],
      "javascript": {
        "globals": [
          "describe",
          "it",
          "test",
          "expect",
          "vi",
          "beforeAll",
          "beforeEach",
          "afterAll",
          "afterEach"
        ]
      }
    }
  ]
}
